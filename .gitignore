# =========================================================================
# GIT IGNORE — Projekt SHADOW WAR (Chummer 5e + custom setting)
# Verzujeme POUZE naši vlastní práci, nikoliv binárky ani oficiální data.
# =========================================================================

# Zálohy ukládaných postav Chummeru
*.chum5
*.chum5e

# Celá instalace Chummeru kromě našeho custom obsahu
# (Vlastní balíčky žijí v Chummer5a/customdata/ a jsou povolené níže.)
Chummer5a/*
!Chummer5a/customdata/

# Verzujeme jen NÁŠ custom balíček pro setting "Shadow War".
# Ostatní (oficiální) balíčky v customdata/ necháváme mimo git.
Chummer5a/customdata/*
!Chummer5a/customdata/ShadowWar 1938/
!Chummer5a/customdata/ShadowWar 1938/*

# Servisní a soukromé soubory Chummeru (logy, uložené postavy, profily).
# (V gitu jsou stejně jen přes customdata, zde pro jistotu.)
Chummer5a/logs/
Chummer5a/saves/
Chummer5a/settings/

# Vytvořené release balíčky (ZIP s Chummerem) — patří do GitHub Releases
dist/
*.zip

# Dočasné a systémové soubory
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc